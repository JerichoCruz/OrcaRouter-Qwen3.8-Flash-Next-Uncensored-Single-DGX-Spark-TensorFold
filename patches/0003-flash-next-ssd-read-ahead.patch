@@ -368,6 +368,17 @@ def stage(w: Weights, b: Buffers, windows: Sequence[tuple[State, Sequence[int]]]
     return segs
 
 
+def read_ahead(w: Weights, history: np.ndarray, tokens: Sequence[int]) -> None:
+    """Start reading the n-gram rows a later ``stage`` of ``tokens`` after ``history`` looks up (tables that read ahead)."""
+
+    toks = np.asarray(tokens, dtype=np.int64)
+    for layer in w.layers:
+        p = layer.ple
+        start = getattr(p.table, "read_ahead", None) if p is not None and w.x3 is None else None
+        if start is not None:
+            start(p.ngram.ids(history, toks))
+
+
 def compute(w: Weights, segs: Sequence[Seg], b: Buffers, *, logits: bool = True, context: int | None = None):
     """The forward's GPU work on staged rows (capturable); ``context`` bounds the attention launches."""
 
